# API Authentication
# This token is used to authenticate requests to the API.
# It should be a long, random string.
API_BEARER_TOKEN=your-super-secret-and-long-bearer-token

# Database Connection
# This is the connection string for the PostgreSQL database.
# The format is: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/cms_pages"
